# Secrets — never commit
.secrets/
*.key
Secrets.plist
.env

# Voice samples and generated audio (personal data, not source)
spike/out/
spike/*.m4a
spike/*.mp3
SampleAudio/

# Xcode
xcuserdata/
*.xcuserstate
*.xcworkspace/xcuserdata/
DerivedData/
build/
*.xcscmblueprint
*.moved-aside

# Python
__pycache__/
*.pyc

# macOS
.DS_Store

# wrangler build state
.wrangler/

# Junk drawer: this repo is edited over a bridge that forbids deleting files,
# so stale git locks and tmp objects get renamed in here instead. Safe to
# delete by hand, and `git gc` will tidy the rest.
_to_delete/

# Launch video working directory. Holds the Hyperframes project, the render,
# and a copy of Georgia.ttf taken from the system for a deterministic render —
# a licensed font that must not be committed. The published video and poster
# live in docs/assets/ instead.
brag-output/
